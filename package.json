{
  "name": "codex-harbor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "check": "tsc --noEmit && node scripts/check-docs.mjs && node --import tsx --test tests/integration/openapi.test.ts && prettier --check \"apps/**/*.ts\" \"apps/**/*.tsx\" \"packages/**/src/**/*.ts\" \"infra/**/*.ts\" \"infra/**/*.mjs\" \"scripts/*.ts\" \"scripts/*.mjs\" \"apps/**/*.css\" \"apps/**/*.html\" \"tests/**/*.ts\" package.json tsconfig.json pnpm-workspace.yaml",
    "test": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e/run.ts",
    "test:contract": "node --import tsx --test tests/contract/*.test.ts",
    "test:live": "node --import tsx tests/live/run.ts",
    "test:isolation": "node --import tsx tests/isolation/run.ts",
    "test:egress": "node --test tests/egress/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "8.3.0",
    "fastify": "5.6.1",
    "openid-client": "6.8.1",
    "pg": "8.16.3",
    "pg-boss": "12.5.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12",
    "ipaddr.js": "2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "jose": "6.1.1",
    "ajv": "8.17.1",
    "prettier": "3.6.2"
  }
}
