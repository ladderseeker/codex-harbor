# Never write __pycache__ beside this script: a release's manifest check refuses files it does not list.
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader('personal_installer', str(Path(__file__).with_name('harbor-personal')))
spec = importlib.util.spec_from_loader(loader.name, loader)
installer = importlib.util.module_from_spec(spec)
loader.exec_module(installer)
require = installer.require

RELEASES = Path('/opt/harbor-personal/releases')
BACKUPS = Path('/var/lib/harbor-personal-backups')
WORK = Path('/var/lib/harbor-deploy')
# systemd keeps the DynamicUser build unit's state and cache directories below these.
BUILD_STATE = Path('/var/lib/private')
BUILD_CACHE = Path('/var/cache/private')
GIB = 1 << 30
KEEP_CHECKPOINTS = 2
# The XDG data, state and config homes of a development project; the rest is cache.
DEVELOPMENT_KEEP = ('config', 'data', 'state')
STAMP = re.compile(r'[0-9]{8}T[0-9]{6}Z')
INSTANCE_NAME = re.compile(r'[a-z][a-z0-9-]{0,23}')
BUSY = "('queued','dispatching','running','waiting_approval','waiting_input','uncertain')"
MIGRATIONS = 'packages/storage/src/migrations'
RELEASE_ROOT_ENTRIES = {'apps', 'packages', 'infra', 'node_modules', 'toolchain', 'package.json',
                        'pnpm-lock.yaml', 'pnpm-workspace.yaml', 'tsconfig.json', 'artifact.json'}
# The first release's pinned downloads: each input's URL and the SHA-256 its file must have. The
# hashes match Node's SHASUMS256.txt and the npm registry's SHA-512 integrity values. Tests may
# replace them.
NODE_URL = 'https://nodejs.org/dist/v24.11.1/node-v24.11.1-linux-x64.tar.xz'
NODE_SHA256 = '60e3b0a8500819514aca603487c254298cd776de0698d3cd08f11dba5b8289a8'
NODE_MEMBER = 'node-v24.11.1-linux-x64/bin/node'
CODEX_URL = 'https://registry.npmjs.org/@openai/codex/-/codex-0.153.4-linux-x64.tgz'
CODEX_SHA256 = '54818cb9fce3360cc6e44cfc5a96952cd5c1243efb43cbe488e11dda84663e08'
CODEX_VENDOR = 'package/vendor/x86_64-unknown-linux-musl'
PNPM_URL = 'https://registry.npmjs.org/pnpm/-/pnpm-12.3.4.tgz'
PNPM_SHA256 = '08a3d2d539b377a6b7ea2469b612672255ca71c30a62698530582cb9d35c268f'
PNPM_EXE_URL = 'https://registry.npmjs.org/@pnpm/exe.linux-x64/-/exe.linux-x64-12.3.4.tgz'
PNPM_EXE_SHA256 = '9b1c95fc413600ca75a51ebe8332d7019dc3568fd4187f5a5f2df4a156efb65c'
