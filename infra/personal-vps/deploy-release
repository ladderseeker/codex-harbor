# Bootstrap has no installed release to measure, so its space need is fixed: four times the release
# built from 9ba6d53 on 30 September 2026, rounded up to a whole GiB. That release allocated 830058496
# bytes; four times is 3320233984 bytes, or 3.09 GiB, so the need is 4 GiB.
BOOTSTRAP_NEED = 4 * GIB


def log(message):
    print('[deploy] ' + message, flush=True)


def sha256(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as stream:
        for block in iter(lambda: stream.read(1 << 20), b''):
            digest.update(block)
    return digest.hexdigest()


def systemctl(*args, check=True):
    return subprocess.run(['/usr/bin/systemctl', *args], check=check, capture_output=True, text=True)


def instance(name):
    require(INSTANCE_NAME.fullmatch(name), 'Invalid instance name')
    unit, etc, state = installer.layout({'instance': name})
    config = Path(etc) / 'config.json'
    require(config.is_file(), 'Instance configuration not found: ' + str(config))
    c = json.loads(config.read_text())
    require(c['instance'] == name, 'Configuration instance mismatch')
    return c, unit, Path(etc), Path(state)


def psql(c, sql):
    _, etc, _ = installer.layout(c)
    result = subprocess.run(['/usr/bin/docker', 'compose', '-f', etc + '/compose.json', 'exec', '-T', 'postgres',
                             'psql', '-U', 'harbor', '-d', 'harbor', '-Atqc', sql],
                            check=True, capture_output=True, text=True)
    return result.stdout.strip()


def ownership(c):
    """Counts that must be zero before stopping (idle runtimes excepted) and all zero after."""
    counts = {'busyOperations': int(psql(c, 'SELECT count(*) FROM operations WHERE state IN ' + BUSY))}
    if psql(c, "SELECT to_regclass('conversation_runtimes') IS NOT NULL") == 't':
        counts['busyRuntimes'] = int(psql(c, "SELECT count(*) FROM conversation_runtimes WHERE state <> 'idle'"))
        counts['idleRuntimes'] = int(psql(c, "SELECT count(*) FROM conversation_runtimes WHERE state = 'idle'"))
    if psql(c, "SELECT count(*) FROM information_schema.columns WHERE table_name='sessions' AND column_name='background_until'") == '1':
        counts['backgroundSessions'] = int(psql(c, 'SELECT count(*) FROM sessions WHERE background_until IS NOT NULL OR background_stop_requested'))
    return counts


def processes_from(release):
    found = []
    for entry in Path('/proc').iterdir():
        if entry.name.isdigit():
            try:
                exe = os.readlink(entry / 'exe')
            except OSError:
                continue
            if exe == str(release) or exe.startswith(str(release) + '/'):
                found.append(int(entry.name))
    return found


def migrations(release):
    directory = Path(release) / MIGRATIONS
    return {p.name: sha256(p) for p in sorted(directory.glob('*.sql')) if re.fullmatch(r'\d{3}_[a-z_]+\.sql', p.name)}


def verify_release(release, revision=None):
    """Authenticate a staged release against its own complete file manifest."""
    release = installer.absolute(str(release))
    manifest = json.loads((release / 'artifact.json').read_text())
    require(manifest.get('profile') == 'personal-vps', 'Not a personal VPS release')
    require(revision is None or manifest.get('baseRevision') == revision, 'Release revision mismatch')
    expected = dict(manifest['files'])
    seen = set()
    for directory, dirs, files in os.walk(release):
        for name in dirs + files:
            path = Path(directory) / name
            info = path.lstat()
            require(info.st_uid == 0 and info.st_gid == 0, 'Release must be root-owned: ' + str(path))
            if path.is_symlink():
                require(path.resolve().is_relative_to(release), 'Release symlink escapes: ' + str(path))
                continue
            require(info.st_mode & 0o022 == 0, 'Release must not be group/world writable: ' + str(path))
            if path.is_file():
                relative = str(path.relative_to(release))
                if relative == 'artifact.json':
                    continue
                require(relative in expected and sha256(path) == expected[relative], 'Release file differs from manifest: ' + relative)
                seen.add(relative)
    require(seen == set(expected), 'Release is missing manifest files')
    installer.validate_native_distribution(release)
    env = {'PATH': '/usr/bin:/bin', 'HOME': '/nonexistent'}
    for command, version in (('bin/node', 'v24.11.1'), ('bin/codex', 'codex-cli 0.153.4'), ('bin/pnpm', '12.3.4')):
        out = subprocess.run([str(release / command), '--version'], env=env, check=True, capture_output=True, text=True).stdout.strip()
        require(out == version, 'Pinned version required for ' + command)
    return manifest


def native_inputs(current, target):
    """Rebuild the exact pinned native inputs from the installed release manifest."""
    manifest = json.loads((current / 'artifact.json').read_text())
    vendor, pnpm = target / 'vendor', target / 'pnpm'
    for relative, digest in manifest['files']:
        top = relative.split('/', 1)[0]
        if relative.startswith('toolchain/pnpm/') and relative != 'toolchain/pnpm/pnpm-native':
            destination = pnpm / relative[len('toolchain/pnpm/'):]
        elif top in RELEASE_ROOT_ENTRIES or relative in ('bin/node', 'bin/pnpm', 'bin/pnpx', 'toolchain/pnpm/pnpm-native'):
            continue
        else:
            destination = vendor / relative
        source = current / relative
        require(sha256(source) == digest, 'Installed release differs from its manifest: ' + relative)
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
    # Symlinks inside the vendor tree (for example PATH helpers) are not in the file list.
    for directory, dirs, files in os.walk(current):
        if Path(directory) == current:
            dirs[:] = [d for d in dirs if d not in RELEASE_ROOT_ENTRIES]
        for name in dirs + files:
            path = Path(directory) / name
            relative = str(path.relative_to(current))
            top = relative.split('/', 1)[0]
            if path.is_symlink() and top not in RELEASE_ROOT_ENTRIES and not relative.startswith('bin/pnp'):
                (vendor / relative).parent.mkdir(parents=True, exist_ok=True)
                os.symlink(os.readlink(path), vendor / relative)
    shutil.copy2(current / 'bin/node', target / 'node')
    shutil.copy2(current / 'toolchain/pnpm/pnpm-native', target / 'pnpm-native')
    finish_inputs(target)


def finish_inputs(target):
    """Complete native inputs that hold node, vendor/, pnpm/ and pnpm-native: the build's PATH and modes."""
    (target / 'bin').mkdir()
    shutil.copy2(target / 'node', target / 'bin/node')
    (target / 'bin/pnpm').write_text('#!/bin/sh\nexec ' + str(target / 'pnpm-native') + ' "$@"\n')
    for path in [target] + list(target.rglob('*')):
        if not path.is_symlink():
            path.chmod(0o755 if path.is_dir() or path.stat().st_mode & 0o111 or path.parent.name == 'bin' else 0o644)
    installer.validate_native_distribution(target / 'vendor', require_root=False)


def download(url, directory, digest):
    """Fetch url over verified HTTPS into a new file in directory and check it against its pinned SHA-256."""
    name = Path(urllib.parse.urlsplit(url).path).name
    require(url.startswith('https://') and name, 'Pinned downloads must use HTTPS: ' + url)
    path = directory / name
    log('Downloading ' + url)
    try:
        with urllib.request.urlopen(url, timeout=DOWNLOAD_TIMEOUT, context=ssl.create_default_context()) as response:
            require(response.geturl().startswith('https://'), 'Download of ' + name + ' left HTTPS')
            with open(path, 'xb') as stream:
                shutil.copyfileobj(response, stream, 1 << 20)
    except (urllib.error.URLError, http.client.HTTPException, OSError) as error:
        raise ValueError('Could not download ' + name + ': ' + (str(error) or type(error).__name__)) from None
    # Nothing reads the file before this check.
    actual = sha256(path)
    require(actual == digest, 'Pinned SHA-256 mismatch for ' + name + ' (got ' + actual + '); this run\'s inputs are deleted')
    log('Verified ' + name + ' SHA-256 ' + actual)
    return path


def unpack(archive, member, destination, tree):
    """Extract one regular file, or with tree the directory below member, from archive as destination.

    Only the named members are read, renamed relative to destination. tarfile's data filter refuses
    absolute paths, parent-directory escapes, special files and links that leave destination."""
    try:
        with tarfile.open(archive) as stream:
            if not tree:
                entry = copy.copy(stream.getmember(member))
                require(entry.isreg(), archive.name + ': ' + member + ' must be a regular file')
                entry.name = destination.name
                stream.extractall(destination.parent, members=[entry], filter='data')
                return
            entries = []
            for found in stream.getmembers():
                if not found.name.startswith(member + '/'):
                    continue
                entry = copy.copy(found)
                entry.name = found.name[len(member) + 1:]
                if found.islnk():
                    require(found.linkname.startswith(member + '/'), archive.name + ': hard link leaves ' + member + ': ' + found.name)
                    entry.linkname = found.linkname[len(member) + 1:]
                entries.append(entry)
            require(entries, archive.name + ' has no ' + member + '/')
            destination.mkdir()
            stream.extractall(destination, members=entries, filter='data')
    except KeyError:
        raise ValueError(archive.name + ' has no ' + member) from None
    except tarfile.TarError as error:
        raise ValueError('Refused ' + archive.name + ': ' + str(error)) from None


def bootstrap_inputs(target):
    """Download, check and unpack the pinned first-release inputs in the layout that native_inputs writes."""
    downloads = target / 'downloads'
    downloads.mkdir(mode=0o700)
    node = download(NODE_URL, downloads, NODE_SHA256)
    codex = download(CODEX_URL, downloads, CODEX_SHA256)
    pnpm = download(PNPM_URL, downloads, PNPM_SHA256)
    native = download(PNPM_EXE_URL, downloads, PNPM_EXE_SHA256)
    unpack(node, NODE_MEMBER, target / 'node', tree=False)
    unpack(codex, CODEX_VENDOR, target / 'vendor', tree=True)
    unpack(pnpm, 'package', target / 'pnpm', tree=True)
    unpack(native, 'package/pnpm', target / 'pnpm-native', tree=False)
    shutil.rmtree(downloads)
    finish_inputs(target)


def allocated(path, seen=None):
    """Allocated bytes of path and everything below it, from lstat block counts.

    Symbolic links are never followed and each (device, inode) counts once, also
    across calls that share `seen`."""
    seen = set() if seen is None else seen
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return 0
    total, pending = 0, [(os.fspath(path), info)]
    while pending:
        current, info = pending.pop()
        key = (info.st_dev, info.st_ino)
        if key in seen:
            continue
        seen.add(key)
        total += info.st_blocks * 512
        if not stat.S_ISDIR(info.st_mode):
            continue
        try:
            fd = os.open(current, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except OSError as error:
            if error.errno in (errno.ENOENT, errno.ENOTDIR, errno.ELOOP):
                continue  # Removed or replaced since it was listed.
            raise
        try:
            opened = os.fstat(fd)
            if (opened.st_dev, opened.st_ino) != key:
                continue  # Replaced since it was listed; never measure through a link.
            with os.scandir(fd) as entries:
                for entry in entries:
                    try:
                        pending.append((current + '/' + entry.name, entry.stat(follow_symlinks=False)))
                    except FileNotFoundError:
                        continue
        finally:
            os.close(fd)
    return total


def reserve(total):
    """Bytes a deploy step leaves free: the larger of 2 GiB and 5% of the filesystem."""
    return max(2 * GIB, total // 20)


def filesystem(path):
    """The device and nearest existing ancestor of a location that a step writes to."""
    path = Path(path)
    while not path.exists():
        path = path.parent
    return os.stat(path).st_dev, path


def mount_point(path):
    """Where the filesystem holding path is mounted; a symbolic link is labelled by its target's mount."""
    path = Path(os.path.realpath(path))
    device = os.stat(path).st_dev
    while path != path.parent and os.stat(path.parent).st_dev == device:
        path = path.parent
    return path


def filesystems(paths):
    """Each filesystem holding one of paths, listed once with its free, total and reserve bytes."""
    found = {}
    for location in paths:
        device, existing = filesystem(location)
        if device not in found:
            usage = shutil.disk_usage(existing)
            found[device] = {'mount': str(mount_point(existing)), 'paths': [], 'freeBytes': usage.free,
                             'totalBytes': usage.total, 'reserveBytes': reserve(usage.total)}
        found[device]['paths'].append(str(location))
    return found


def shortfalls(paths, need):
    """The filesystems among paths that would keep less than their reserve free after need more bytes."""
    return [fs for fs in filesystems(paths).values() if fs['freeBytes'] < need + fs['reserveBytes']]


def require_space(action, paths, need):
    for fs in shortfalls(paths, need):
        raise ValueError(action + ' needs ' + str(need) + ' bytes plus a reserve of ' + str(fs['reserveBytes'])
                         + ' bytes on the filesystem mounted at ' + fs['mount'] + ', which has ' + str(fs['freeBytes'])
                         + ' bytes free; nothing was changed')


def build_locations(releases=None, work=None, build_state=None, build_cache=None):
    """Every location a build writes to: native inputs, the build unit's state and cache, and the release."""
    return [WORK if work is None else Path(work), BUILD_STATE if build_state is None else Path(build_state),
            BUILD_CACHE if build_cache is None else Path(build_cache), RELEASES if releases is None else Path(releases)]


def reuse(release, revision):
    """Print the result for a release that is already staged, once it verifies against revision."""
    verify_release(release, revision)
    log('Release already staged and verified: ' + str(release))
    print(json.dumps({'release': str(release), 'reused': True}))


def build(args):
    c, _, _, _ = instance(args.instance)
    require(re.fullmatch(r'[0-9a-f]{40}', args.revision), 'Full commit SHA required')
    name = 'gha-' + args.revision[:12]
    release = RELEASES / name
    if release.exists():
        reuse(release, args.revision)
        return
    current = Path(c['release'])
    verify_release(current)
    bundle = installer.absolute(args.bundle)
    # A build writes inputs, sources, dependencies, the package and the release: about four releases.
    require_space('Build', build_locations(), 4 * allocated(current))
    build_and_stage(name, 'harbor-deploy-build-' + args.revision[:12], bundle, args.revision,
                    lambda inputs: native_inputs(current, inputs))


def build_and_stage(name, unit, bundle, revision, prepare):
    """Build revision from bundle in the transient unprivileged unit and stage it as RELEASES/name.

    prepare(inputs) writes the pinned native inputs. Inputs, build state and a staging directory that
    this run created are removed on every exit; an existing staging directory is refused and left."""
    release = RELEASES / name
    run_id = name + '-' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    inputs = WORK / 'inputs' / run_id
    inputs.mkdir(parents=True, mode=0o755)
    for parent in (WORK, WORK / 'inputs'):
        parent.chmod(0o755)
    state_name = 'harbor-deploy-build/' + run_id
    state = BUILD_STATE / state_name
    staging = None  # Set only while this run owns a staging directory it created.
    try:
        prepare(inputs)
        log('Building ' + revision + ' as a transient unprivileged user')
        script = ('set -eu; cd "$STATE_DIRECTORY"; '
                  'git clone -q --no-checkout "$BUNDLE" source; cd source; git checkout -q --detach "$REVISION"; '
                  'test "$(git rev-parse HEAD)" = "$REVISION"; '
                  'pnpm install --frozen-lockfile; pnpm build; '
                  'python3 infra/personal-vps/package-release.py --source . --node "$INPUTS/node" '
                  '--vendor "$INPUTS/vendor" --pnpm-package "$INPUTS/pnpm" --pnpm-binary "$INPUTS/pnpm-native" '
                  '--output "$STATE_DIRECTORY/package"')
        subprocess.run(['/usr/bin/systemd-run', '--quiet', '--wait', '--pipe', '--collect',
                        '--unit=' + unit,
                        '-p', 'DynamicUser=yes', '-p', 'StateDirectory=' + state_name,
                        '-p', 'CacheDirectory=harbor-deploy-cache', '-p', 'NoNewPrivileges=yes',
                        '-p', 'MemoryMax=6G', '-p', 'RuntimeMaxSec=3600',
                        '--setenv=PATH=' + str(inputs / 'bin') + ':/usr/bin:/bin',
                        '--setenv=HOME=/var/lib/' + state_name, '--setenv=CI=true',
                        '--setenv=npm_config_store_dir=/var/cache/harbor-deploy-cache/pnpm-store',
                        '--setenv=BUNDLE=' + str(bundle), '--setenv=REVISION=' + revision,
                        '--setenv=INPUTS=' + str(inputs),
                        '/bin/sh', '-c', script], check=True)
        package = state / 'package'
        result = json.loads((package / 'package-result.json').read_text())
        require(sha256(result['archive']) == result['sha256'], 'Package archive hash mismatch')
        target = RELEASES / ('.staging-' + name)
        require(not os.path.lexists(target), 'Staging path exists; inspect it first: ' + str(target))
        target.mkdir(mode=0o700)
        staging = target
        shutil.copytree(package / 'release', staging, symlinks=True, dirs_exist_ok=True)
        for directory, dirs, files in os.walk(staging):
            for entry in [Path(directory)] + [Path(directory) / n for n in dirs + files]:
                os.lchown(entry, 0, 0)
        verify_release(staging, revision)
        staging.rename(release)
        staging = None
        manifest_sha = sha256(release / 'artifact.json')
        log('Staged ' + str(release))
        print(json.dumps({'release': str(release), 'revision': revision, 'archiveSha256': result['sha256'],
                          'fileCount': result['fileCount'], 'manifestSha256': manifest_sha, 'reused': False}))
    finally:
        if staging is not None:
            shutil.rmtree(staging, ignore_errors=True)
            if os.path.lexists(staging):
                log('Could not remove the partial staging directory ' + str(staging))
        shutil.rmtree(inputs, ignore_errors=True)
        shutil.rmtree(state, ignore_errors=True)


def bootstrap(args):
    """Build and stage the first release on a host without an instance, from pinned downloads."""
    require(os.geteuid() == 0, 'Bootstrap requires root')
    require(platform.system() == 'Linux' and platform.machine() == 'x86_64', 'Bootstrap supports Linux x86_64 only')
    require(re.fullmatch(r'[0-9a-f]{40}', args.revision), 'Full commit SHA required')
    configured = configured_instances()
    require(not configured, 'This host has an instance configuration (' + ', '.join(configured)
            + '); build its releases with build instead; nothing was changed')
    name = 'bootstrap-' + args.revision[:12]
    release = RELEASES / name
    if release.exists():
        reuse(release, args.revision)
        return
    staging = RELEASES / ('.staging-' + name)
    require(not os.path.lexists(staging), 'Staging path exists; inspect it first: ' + str(staging))
    bundle = installer.absolute(args.bundle)
    require(bundle.is_file(), 'Source bundle not found: ' + str(bundle))
    require_space('Bootstrap', build_locations(), BOOTSTRAP_NEED)
    # The release parents, created root-owned and traversable as the installer requires.
    for directory in (RELEASES.parent, RELEASES):
        if not os.path.lexists(directory):
            directory.mkdir(mode=0o755)
            directory.chmod(0o755)
    build_and_stage(name, 'harbor-deploy-build-bootstrap-' + args.revision[:12], bundle, args.revision,
                    bootstrap_inputs)


def switched_files(c, unit, etc):
    """Map installed generated files to their exact expected contents for this configuration."""
    password = (etc / 'database.password').read_text().strip()
    secret = Path(c['oidcSecretFile']).read_text().strip() if c['oidcSecretFile'] else None
    files = {}
    for filename, content in installer.artifacts(c, password, secret).items():
        if filename.endswith('.service'):
            files[Path('/etc/systemd/system') / filename] = content
        elif filename.endswith('.apparmor'):
            files[Path('/etc/apparmor.d') / filename] = content
        elif filename == 'service.env':
            files[etc / filename] = content
    files[etc / 'config.json'] = json.dumps(c, indent=2) + '\n'
    return files


def generated_drift(files):
    # config.json formatting is not significant; its parsed content is the configuration itself.
    return [str(p) for p, content in files.items() if p.name != 'config.json' and not (p.is_file() and p.read_text() == content)]


def write_files(files):
    for path, content in files.items():
        temporary = path.with_name('.' + path.name + '.deploy')
        mode = path.stat().st_mode & 0o777
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
        os.chmod(temporary, mode)
        os.replace(temporary, path)


def activate(c, unit, files):
    write_files(files)
    for path in files:
        if path.suffix == '.apparmor':
            subprocess.run(['/usr/sbin/apparmor_parser', '-Q', '-K', str(path)], check=True)
            subprocess.run(['/usr/sbin/apparmor_parser', '-r', str(path)], check=True)
    systemctl('daemon-reload')
    systemctl('start', unit + '-api.service', unit + '-supervisor.service')


def drop_ins(unit):
    found = {}
    for role in ('api', 'supervisor'):
        directory = Path('/etc/systemd/system') / (unit + '-' + role + '.service.d')
        if directory.is_dir():
            for path in sorted(directory.iterdir()):
                found[str(path)] = sha256(path)
    return found


def http_status(url):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, method='GET'), timeout=10,
                                    context=ssl.create_default_context()) as response:
            return response.status
    except urllib.error.HTTPError as error:
        return error.code
    except (urllib.error.URLError, OSError):
        return None


def installed_check(c, unit, release):
    deadline = time.time() + 120
    while True:
        states = [systemctl('is-active', unit + '-' + r + '.service', check=False).stdout.strip() for r in ('api', 'supervisor')]
        health = http_status(c['origin'] + '/health')
        if states == ['active', 'active'] and health == 200:
            break
        require(time.time() < deadline, 'Installed readiness failed: services ' + ','.join(states) + ', health ' + str(health))
        time.sleep(3)
    for role in ('api', 'supervisor'):
        pid = systemctl('show', '-p', 'MainPID', '--value', unit + '-' + role + '.service').stdout.strip()
        require(pid != '0' and os.readlink('/proc/' + pid + '/exe') == str(release / 'bin/node'), role + ' is not running from the new release')
    for path in ('/', '/api/v1/me'):
        require(http_status(c['origin'] + path) == 401, 'Anonymous request was not refused: ' + path)


def real_directory(path):
    return stat.S_ISDIR(os.lstat(path).st_mode)


def checkpoint_plan(state):
    """Relative directories to rebuild and entries to copy for a checkpoint of private state.

    PostgreSQL data is dumped separately and Codex scratch (codex-home/.tmp) is left out. Of each
    home/development/<project> directory only the XDG data, state and config homes are kept; the
    rest is the project's XDG, npm and pnpm cache. Symbolic links are copied, never followed."""
    rebuild, copies = [], []
    for child in sorted(os.listdir(state)):
        if child == 'postgres':
            continue
        if child == 'codex-home' and real_directory(state / child):
            rebuild.append(child)
            copies += [child + '/' + name for name in sorted(os.listdir(state / child)) if name != '.tmp']
        elif child == 'home' and real_directory(state / child):
            rebuild.append(child)
            for name in sorted(os.listdir(state / child)):
                entry = child + '/' + name
                if name != 'development' or not real_directory(state / entry):
                    copies.append(entry)
                    continue
                rebuild.append(entry)
                for project in sorted(os.listdir(state / entry)):
                    relative = entry + '/' + project
                    if not real_directory(state / relative):
                        copies.append(relative)
                        continue
                    rebuild.append(relative)
                    copies += [relative + '/' + item for item in sorted(os.listdir(state / relative))
                               if item in DEVELOPMENT_KEEP]
        else:
            copies.append(child)
    return rebuild, copies


def copy_state(state, target):
    """Copy private state into the existing empty directory target, following checkpoint_plan."""
    rebuild, copies = checkpoint_plan(state)
    for relative in rebuild:
        (target / relative).mkdir(mode=0o700)
    for relative in copies:
        subprocess.run(['/bin/cp', '-a', str(state / relative), str(target / relative)], check=True)
    # Rebuilt directories take their source's owner, mode and timestamps once their content is in place.
    for relative in reversed(rebuild):
        source = os.lstat(state / relative)
        os.chown(target / relative, source.st_uid, source.st_gid)
        os.chmod(target / relative, stat.S_IMODE(source.st_mode))
        os.utime(target / relative, ns=(source.st_atime_ns, source.st_mtime_ns))


def checkpoint_need(c, etc, state):
    """Estimated checkpoint bytes: the state it copies, the instance configuration and the database."""
    rebuild, copies = checkpoint_plan(state)
    seen = set()
    need = sum(os.lstat(state / relative).st_blocks * 512 for relative in rebuild)
    need += sum(allocated(state / relative, seen) for relative in copies)
    need += allocated(etc, seen)
    return need + int(psql(c, "SELECT pg_database_size('harbor')"))


def checkpoint(c, unit, etc, state, name, backups=None):
    backups = BACKUPS if backups is None else Path(backups)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    backups.mkdir(mode=0o700, exist_ok=True)
    target = backups / (name + '-' + stamp)
    target.mkdir(mode=0o700)
    try:
        dump = target / 'database.dump'
        with open(dump, 'wb') as stream:
            subprocess.run(['/usr/bin/docker', 'compose', '-f', str(etc / 'compose.json'), 'exec', '-T', 'postgres',
                            'pg_dump', '-U', 'harbor', '-d', 'harbor', '-Fc'], check=True, stdout=stream)
        with open(dump, 'rb') as stream:
            subprocess.run(['/usr/bin/docker', 'compose', '-f', str(etc / 'compose.json'), 'exec', '-T', 'postgres',
                            'pg_restore', '--list'], check=True, stdin=stream, stdout=subprocess.DEVNULL)
        subprocess.run(['/bin/cp', '-a', str(etc), str(target / 'etc')], check=True)
        units = target / 'systemd'
        units.mkdir()
        for path in Path('/etc/systemd/system').glob(unit + '-*'):
            subprocess.run(['/bin/cp', '-a', str(path), str(units / path.name)], check=True)
        apparmor = Path('/etc/apparmor.d') / (unit + '.apparmor')
        if apparmor.exists():
            subprocess.run(['/bin/cp', '-a', str(apparmor), str(target / 'apparmor')], check=True)
        (target / 'state').mkdir(mode=0o711)
        copy_state(state, target / 'state')
        receipt = {'release': c['release'], 'databaseSha256': sha256(dump), 'createdAt': stamp}
        (target / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
    except BaseException:
        # This run created the target; a partial checkpoint is never left behind.
        shutil.rmtree(target, ignore_errors=True)
        if os.path.lexists(target):
            log('Could not remove the partial checkpoint ' + str(target))
        raise
    log('Checkpoint ' + str(target) + ' database SHA256 ' + receipt['databaseSha256'])
    return target


def promote(args):
    require(os.geteuid() == 0, 'Promotion requires root')
    c, unit, etc, state = instance(args.instance)
    installer.validate(c)
    old = Path(c['release'])
    new = installer.absolute(args.release)
    require(new.parent == RELEASES and new != old, 'Candidate must be a different release under ' + str(RELEASES))
    manifest = verify_release(new)
    log('Candidate ' + str(new) + ' revision ' + manifest['baseRevision'])

    before, after = migrations(old), migrations(new)
    changed = [n for n in before if after.get(n) != before[n]]
    require(not changed, 'Candidate changes or removes existing migrations: ' + ', '.join(changed))
    added = sorted(set(after) - set(before))
    require(not added or args.allow_new_migrations,
            'Candidate adds migrations ' + ', '.join(added) + '; rerun with allow_new_migrations after reviewing them')
    applied = dict(line.split('|') for line in psql(c, 'SELECT version,digest FROM harbor_migrations ORDER BY version').splitlines())
    require(applied == before, 'Applied database migrations do not match the installed release')

    new_config = dict(c, release=str(new))
    installer.validate(new_config)
    old_files, new_files = switched_files(c, unit, etc), switched_files(new_config, unit, etc)
    require(not generated_drift(old_files), 'Installed files differ from their generated form; refusing: ' + ', '.join(generated_drift(old_files)))
    sites = drop_ins(unit)
    require_space('Promotion checkpoint', [BACKUPS], checkpoint_need(c, etc, state))

    counts = ownership(c)
    require(not any(v for k, v in counts.items() if k != 'idleRuntimes'), 'Work is active; nothing was changed. Counts: ' + json.dumps(counts))
    log('Idle: ' + json.dumps(counts) + '. Stopping API admission.')
    systemctl('stop', unit + '-api.service')
    counts = ownership(c)
    if any(v for k, v in counts.items() if k != 'idleRuntimes'):
        systemctl('start', unit + '-api.service')
        raise ValueError('Work started during drain; API restarted on the old release. Counts: ' + json.dumps(counts))
    systemctl('stop', unit + '-supervisor.service')
    counts, leftovers = ownership(c), processes_from(old)
    if any(counts.values()) or leftovers:
        systemctl('start', unit + '-api.service', unit + '-supervisor.service')
        raise ValueError('Supervisor stop left runtime ownership or processes; old release restarted and nothing was promoted. '
                         'Counts: ' + json.dumps(counts) + ', processes: ' + str(len(leftovers)))

    try:
        backup = checkpoint(c, unit, etc, state, new.name)
    except Exception:
        systemctl('start', unit + '-api.service', unit + '-supervisor.service')
        log('Checkpoint failed; old release restarted and nothing was promoted.')
        raise

    log('Switching ' + old.name + ' -> ' + new.name)
    try:
        activate(new_config, unit, new_files)
        installed_check(new_config, unit, new)
        require(drop_ins(unit) == sites, 'Site drop-ins changed during promotion')
    except Exception:
        systemctl('stop', unit + '-api.service', unit + '-supervisor.service', check=False)
        if added:
            log('New release failed after migrations may have run. Services are stopped; the old release must not open '
                'this database. Recover over SSH from checkpoint ' + str(backup) + '.')
            raise
        log('New release failed; restoring the previous release files.')
        activate(c, unit, old_files)
        installed_check(c, unit, old)
        log('Previous release ' + old.name + ' is running again.')
        raise
    log('Promoted ' + str(new))
    print(json.dumps({'release': str(new), 'previous': str(old), 'revision': manifest['baseRevision'],
                      'manifestSha256': sha256(new / 'artifact.json'), 'checkpoint': str(backup),
                      'addedMigrations': added}))


def real_children(directory):
    """Real directories directly below directory; symbolic links are never followed."""
    try:
        require(real_directory(directory), str(directory) + ' must be a real directory')
    except FileNotFoundError:
        return []
    found = []
    for name in sorted(os.listdir(directory)):
        try:
            if real_directory(directory / name):
                found.append(directory / name)
        except FileNotFoundError:
            continue
    return found


def checkpoint_receipt(directory):
    """The receipt of a checkpoint that deploy-release wrote, or None for any other directory."""
    path = directory / 'receipt.json'
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode):
            return None
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    with os.fdopen(fd, 'rb') as stream:
        opened = os.fstat(stream.fileno())
        if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
            return None
        try:
            receipt = json.loads(stream.read(1 << 20))
        except ValueError:
            return None
    if not isinstance(receipt, dict) or not all(isinstance(receipt.get(k), str) for k in ('release', 'databaseSha256', 'createdAt')):
        return None
    created = receipt['createdAt']
    if not STAMP.fullmatch(created) or not directory.name.endswith('-' + created):
        return None
    try:
        datetime.datetime.strptime(created, '%Y%m%dT%H%M%SZ')
    except ValueError:
        return None
    return receipt


def codex_scratch(checkpoint_directory):
    """state/codex-home/.tmp of a checkpoint when every component is a real directory, else None."""
    path = checkpoint_directory
    for part in ('state', 'codex-home', '.tmp'):
        path = path / part
        try:
            if not real_directory(path):
                return None
        except FileNotFoundError:
            return None
    return path


def configured_instances():
    """Every instance with a configuration on this host, found through the installer's layout naming."""
    sample = 'a'
    etc = Path(installer.layout({'instance': sample})[1])
    root, prefix = etc.parent, etc.name[:-len(sample)]
    try:
        entries = sorted(os.listdir(root))
    except FileNotFoundError:
        return []
    names = []
    for entry in entries:
        name = entry[len(prefix):]
        if (entry.startswith(prefix) and INSTANCE_NAME.fullmatch(name)
                and Path(installer.layout({'instance': name})[1]) == root / entry
                and os.path.lexists(root / entry / 'config.json')):
            names.append(name)
    return names


def prune_refusal(c):
    """Why prune must not run on this host, or None.

    Releases and checkpoints are shared by every instance on the host, but prune keeps only the
    selected instance's release and ranks all checkpoints together. The names are safe to print:
    configured_instances accepts only names that match INSTANCE_NAME."""
    others = [name for name in configured_instances() if name != c['instance']]
    if others:
        return ('Prune supports single-instance hosts only, and this host has ' + str(len(others))
                + ' other instance configuration' + ('s' if len(others) > 1 else '') + ': ' + ', '.join(others))
    return None


def prune_plan(c, keep=KEEP_CHECKPOINTS, releases=None, backups=None):
    """What prune keeps and removes among the direct children of the release and backup directories.

    It keeps the installed release, releases a process runs from, the newest `keep` checkpoints that
    deploy-release wrote and the releases their receipts name. It removes the other recognized
    checkpoints and releases, and Codex scratch from each kept checkpoint that deploy-release wrote.
    Other backup directories, names starting with a dot and symbolic links are left alone."""
    releases = RELEASES if releases is None else Path(releases)
    backups = BACKUPS if backups is None else Path(backups)
    require(type(keep) is int and 1 <= keep <= 10, 'Keep between 1 and 10 checkpoints')
    checkpoints, recognized = [], []
    for directory in real_children(backups):
        entry = {'name': directory.name, 'path': str(directory), 'bytes': allocated(directory)}
        checkpoints.append(entry)
        hidden = directory.name.startswith('.')
        receipt = None if hidden else checkpoint_receipt(directory)
        if receipt:
            recognized.append((receipt['createdAt'], directory.name, receipt['release'], entry))
        elif hidden:
            entry.update(keep=True, reason='hidden directory')
        else:
            entry.update(keep=True, reason='not a checkpoint written by deploy-release')
    recognized.sort(key=lambda item: item[:2], reverse=True)
    named, trimmed = set(), set()
    for index, (_, _, release, entry) in enumerate(recognized):
        if index < keep:
            entry.update(keep=True, reason='one of the newest ' + str(keep) + ' checkpoints')
            named.add(os.path.normpath(release))
            trimmed.add(entry['path'])
        else:
            entry.update(keep=False, reason='older than the newest ' + str(keep) + ' checkpoints')
    installed = os.path.normpath(c['release'])
    listed = []
    for directory in real_children(releases):
        entry = {'name': directory.name, 'path': str(directory), 'bytes': allocated(directory)}
        if directory.name.startswith('.'):
            entry.update(keep=True, reason='staging or hidden directory')
        elif str(directory) == installed:
            entry.update(keep=True, reason='installed release')
        elif processes_from(directory):
            entry.update(keep=True, reason='a process runs from it')
        elif str(directory) in named:
            entry.update(keep=True, reason='named by a kept checkpoint')
        else:
            entry.update(keep=False, reason='not installed, running or named by a kept checkpoint')
        listed.append(entry)
    remove = [{'path': e['path'], 'kind': 'release', 'bytes': e['bytes']} for e in listed if not e['keep']]
    remove += [{'path': e['path'], 'kind': 'checkpoint', 'bytes': e['bytes']} for e in checkpoints if not e['keep']]
    for entry in checkpoints:
        # Only kept checkpoints that deploy-release wrote; other backup directories stay untouched.
        scratch = codex_scratch(Path(entry['path'])) if entry['path'] in trimmed else None
        if scratch:
            remove.append({'path': str(scratch), 'kind': 'codex-scratch', 'bytes': allocated(scratch)})
    return {'releases': listed, 'checkpoints': checkpoints, 'remove': remove}


def remove_contents(directory):
    with os.scandir(directory) as entries:
        names = [(entry.name, entry.is_dir(follow_symlinks=False)) for entry in entries]
    for name, is_directory in names:
        if is_directory:
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            try:
                remove_contents(child)
            finally:
                os.close(child)
            os.rmdir(name, dir_fd=directory)
        else:
            os.unlink(name, dir_fd=directory)


def remove_tree(root, relative):
    """Delete the real directory root/relative. No symbolic link is followed on the way or inside it."""
    parts = Path(relative).parts
    require(parts and not any(part in ('', '.', '..') or '/' in part for part in parts), 'Invalid removal path')
    parent = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for part in parts[:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
            os.close(parent)
            parent = child
        target = os.open(parts[-1], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        try:
            remove_contents(target)
        finally:
            os.close(target)
        os.rmdir(parts[-1], dir_fd=parent)
    finally:
        os.close(parent)


def disk_report(c, etc, state, releases=None, backups=None, work=None, build_state=None, build_cache=None):
    """Read-only disk use: filesystems, build and checkpoint needs, Codex scratch and what prune would do."""
    releases = RELEASES if releases is None else Path(releases)
    backups = BACKUPS if backups is None else Path(backups)
    build_paths = build_locations(releases, work, build_state, build_cache)
    build_need = 4 * allocated(Path(c['release']))
    checkpoint_bytes = checkpoint_need(c, etc, state)
    report = {'filesystems': list(filesystems([releases, backups, Path(state)] + build_paths[:3]).values()),
              'buildNeedBytes': build_need, 'buildFits': not shortfalls(build_paths, build_need),
              'checkpointNeedBytes': checkpoint_bytes, 'checkpointFits': not shortfalls([backups], checkpoint_bytes),
              'codexScratchBytes': allocated(Path(state) / 'codex-home' / '.tmp')}
    try:
        refusal = prune_refusal(c)
        if refusal:
            raise ValueError(refusal)
        plan = prune_plan(c, KEEP_CHECKPOINTS, releases, backups)
    except (ValueError, OSError) as error:
        # The report never fails because prune cannot run; prune itself still refuses.
        report.update(pruneAvailable=False,
                      pruneUnavailableReason=str(error) if isinstance(error, ValueError) else type(error).__name__)
        return report
    summary = lambda entries: [{k: e[k] for k in ('name', 'bytes', 'keep', 'reason')} for e in entries]
    report.update(pruneAvailable=True, releases=summary(plan['releases']), checkpoints=summary(plan['checkpoints']),
                  pruneKeepCheckpoints=KEEP_CHECKPOINTS, pruneWouldRemove=[item['path'] for item in plan['remove']],
                  pruneWouldFreeBytes=sum(item['bytes'] for item in plan['remove']))
    return report


def preflight(args):
    c, unit, etc, state = instance(args.instance)
    report = {'hostname': os.uname().nodename, 'release': c['release'],
              'services': {r: systemctl('is-active', unit + '-' + r + '.service', check=False).stdout.strip()
                           for r in ('dependencies', 'api', 'supervisor')},
              'ownership': ownership(c), 'dropIns': sorted(drop_ins(unit)),
              'generatedFileDrift': generated_drift(switched_files(c, unit, etc)),
              'freeBytes': shutil.disk_usage('/opt').free,
              'disk': disk_report(c, etc, state),
              'health': http_status(c['origin'] + '/health')}
    verify_release(Path(c['release']))
    report['releaseVerified'] = True
    print(json.dumps(report, indent=2))


def prune(args):
    """Delete old releases and checkpoints under the fixed retention rule of prune_plan."""
    require(os.geteuid() == 0, 'Prune requires root')
    keep = args.keep_checkpoints
    require(type(keep) is int and 1 <= keep <= 10, 'Keep between 1 and 10 checkpoints')
    c, _, _, _ = instance(args.instance)
    refusal = prune_refusal(c)
    require(not refusal, str(refusal) + '; nothing was changed')
    plan = prune_plan(c, keep)
    result = {'keepCheckpoints': keep, 'removed': [], 'freedBytes': 0, 'skipped': []}
    item = None
    try:
        for item in plan['remove']:
            path = Path(item['path'])
            if item['kind'] == 'release':
                # Recheck immediately before deleting: a release may have been installed or started since.
                installed = os.path.normpath(instance(args.instance)[0]['release'])
                if str(path) == installed or processes_from(path):
                    result['skipped'].append({'path': item['path'], 'reason': 'installed or running when rechecked'})
                    continue
                remove_tree(RELEASES, path.name)
            else:
                remove_tree(BACKUPS, str(path.relative_to(BACKUPS)))
            result['removed'].append(item['path'])
            result['freedBytes'] += item['bytes']
            log('Removed ' + item['path'] + ' (' + str(item['bytes']) + ' bytes)')
        item = None
    except BaseException:
        if item is not None:
            result['failed'] = item['path']  # The item in progress; it may be partly deleted.
        raise
    finally:
        print(json.dumps(result))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    for action in ('preflight', 'build', 'promote', 'prune'):
        p = sub.add_parser(action)
        p.add_argument('--instance', required=True)
    sub.choices['build'].add_argument('--bundle', required=True)
    sub.choices['build'].add_argument('--revision', required=True)
    sub.choices['promote'].add_argument('--release', required=True)
    sub.choices['promote'].add_argument('--allow-new-migrations', action='store_true')
    sub.choices['prune'].add_argument('--keep-checkpoints', type=int, default=KEEP_CHECKPOINTS)
    first = sub.add_parser('bootstrap')
    first.add_argument('--bundle', required=True)
    first.add_argument('--revision', required=True)
    args = parser.parse_args()
    require(os.geteuid() == 0, 'Run as root on the VPS')
    {'preflight': preflight, 'build': build, 'promote': promote, 'prune': prune,
     'bootstrap': bootstrap}[args.action](args)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, KeyError, subprocess.CalledProcessError) as error:
        # Never print configuration values or subprocess environments; they can hold secrets.
        detail = str(error) if isinstance(error, ValueError) else type(error).__name__
        if isinstance(error, subprocess.CalledProcessError):
            detail += ': ' + Path(str(error.cmd[0])).name + ' exited ' + str(error.returncode)
        print('Deploy failed: ' + detail, file=sys.stderr)
        sys.exit(1)
